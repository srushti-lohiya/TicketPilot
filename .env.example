# Local defaults: do not change your existing DB or model to test hosting.
DEMO_MODE=0
# DB_PATH=/absolute/path/to/your/local/supportpilot.db
# Hosted public demo: DEMO_MODE=1 forces a separate temporary database and ignores DB_PATH.
# Submit only fictional data; public demo tickets are shared and lost on service restart/sleep.
RETRIEVAL_BACKEND=auto
# Render Free uses RETRIEVAL_BACKEND=tfidf, no Torch/transformers, no paid LLM.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For hosting replace with your exact Vercel origin (no wildcard or trailing slash):
# CORS_ORIGINS=https://your-project.vercel.app
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Local authenticated review only; never set a reviewer token or LLM key in the public demo.
# TICKETPILOT_REVIEWER_TOKEN=replace-with-a-local-secret
