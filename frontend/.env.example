# Local Next.js proxy upstream (server-only; never use NEXT_PUBLIC_ for this setting).
TICKETPILOT_API_URL=http://127.0.0.1:8000
# Vercel Production/Preview: set to the exact Render HTTPS origin, no path or /api suffix:
# TICKETPILOT_API_URL=https://YOUR-SERVICE.onrender.com
# No reviewer token, LLM key, database, or model belongs in Vercel environment variables.
# Evaluation is statically bundled; no runtime reports directory is needed.
